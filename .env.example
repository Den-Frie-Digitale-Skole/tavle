# =============================================================================
# Collaborative Whiteboard - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control!

# =============================================================================
# REQUIRED FOR PRODUCTION
# =============================================================================

# Flask secret key for session management (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=dev-secret-key-change-in-production

# Admin API token for administrative endpoints (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
ADMIN_API_TOKEN=dev-admin-token-change-in-production

# Environment (set to 'production' to enable security checks)
FLASK_ENV=development
# FLASK_ENV=production

# Allowed origins for CORS/WebSocket connections (comma-separated)
# In production, set to your actual domain(s)
ALLOWED_ORIGINS=*
# ALLOWED_ORIGINS=https://whiteboard.example.com,https://www.whiteboard.example.com

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL connection URL (leave empty for SQLite in development)
# Format: postgresql://user:password@host:port/database
# DATABASE_URL=postgresql://whiteboard:secretpassword@localhost:5432/whiteboard

# Connection pool settings (PostgreSQL only)
DB_MAX_CONNECTIONS=32
DB_STALE_TIMEOUT=300
DB_TIMEOUT=30

# =============================================================================
# APPLICATION LIMITS
# =============================================================================

# Maximum strokes per board (prevents memory exhaustion)
MAX_STROKES_PER_BOARD=10000

# Maximum images per board
MAX_IMAGES_PER_BOARD=100

# Maximum image size in bytes (5MB default)
MAX_IMAGE_SIZE=5242880

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log directory (created automatically if doesn't exist)
LOG_DIR=logs

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# CONTENT SECURITY POLICY (OPTIONAL OVERRIDE)
# =============================================================================

# Custom CSP policy (uses secure defaults if not set)
# CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ws: wss:; font-src 'self'; frame-ancestors 'self';

# =============================================================================
# DOCKER / PRODUCTION SETTINGS
# =============================================================================

# Host and port (usually set by Docker/orchestrator)
HOST=0.0.0.0
PORT=5050

# Number of gunicorn workers (keep at 1 for SocketIO)
WORKERS=1
